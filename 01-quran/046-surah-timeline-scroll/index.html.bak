};
function tr(key){return T[currentLang]&&T[currentLang][key]||T["en"][key]||key;}
function updateUI(){
  // Title & splash
  var st=document.querySelector(".splash-title");if(st)st.textContent=tr("title");
  var ss=document.querySelector(".splash-subtitle");if(ss)ss.textContent=tr("subtitle");
  var sd=document.getElementById("splDesc");if(sd)sd.textContent=tr("desc");
  var eb=document.getElementById("enterBtn");if(eb)eb.textContent=tr("startMission");
  // App header
  var h1=document.querySelector(".app h1, .hdr h1");if(h1)h1.textContent=tr("title");
  // Status
  var sta=document.getElementById("status");if(sta&&!sta.classList.contains("win")&&!sta.classList.contains("lose"))sta.textContent=tr("status");
  // Start button
  var sb=document.getElementById("startBtn");if(sb)sb.textContent=tr("newGame");
  // Footer
  var ft=document.querySelector(".foot");if(ft)ft.textContent=tr("footer");
  // Help sidebar
  var ht=document.querySelector(".sidebar-title");if(ht)ht.innerHTML="\u2753 "+tr("help");
  var tabs=document.querySelectorAll(".help-tab");
  if(tabs.length>=3){tabs[0].textContent=tr("faq");tabs[1].textContent=tr("howTo");tabs[2].textContent=tr("wiki");}
  // Back link
  var bl=document.getElementById("backLink");if(bl)bl.textContent=tr("catalog");
  // Lang/Theme labels
  document.querySelectorAll(".sw-label").forEach(function(el,i){if(i===0)el.textContent=tr("lang");else if(i===1)el.textContent=tr("theme");});
  // Score labels
  document.querySelectorAll(".score-label").forEach(function(el,i){var k="score"+i;if(T[currentLang][k])el.textContent=tr(k);});
  // Difficulty options
  var ds=document.getElementById("diffSel");
  if(ds){var opts=ds.querySelectorAll("option");opts.forEach(function(o,i){var k="diff"+i;if(T[currentLang][k])o.textContent=tr(k);});};
  // FAQ items
  var faqItems=document.querySelectorAll("#help-faq .help-item");
  faqItems.forEach(function(item,i){
    var sum=item.querySelector("summary");if(sum)sum.textContent=tr("faq"+i+"q");
    var p=item.querySelector("p");if(p)p.textContent=tr("faq"+i+"a");
  });
  // Howto steps
  var howtoSteps=document.querySelectorAll("#help-howto .help-step p");
  howtoSteps.forEach(function(p,i){p.textContent=tr("howto"+i);});
  // Wiki entries
  var wikiEntries=document.querySelectorAll("#help-wiki .wiki-entry");
  wikiEntries.forEach(function(entry,i){
    var h=entry.querySelector("h3");if(h)h.textContent=tr("wiki"+i+"t");
    var p=entry.querySelector("p");if(p)p.textContent=tr("wiki"+i+"c");
  });
  // Sidebar footer
  var sf=document.querySelector(".sidebar-footer");if(sf)sf.textContent=tr("footer");
  // Play button if exists
  var pb=document.querySelector("#playBtn,button:not(.sw-btn):not(.btn-go):not(.btn-close):not(.btn-help):not(.help-tab)");
  // Filter buttons with specific text
  document.querySelectorAll(".filter-btn").forEach(function(btn){
    var txt=btn.textContent.trim();
    var k="ui_"+txt.replace(/ /g,"_").replace(/\//g,"_").toLowerCase();
    if(T[currentLang][k])btn.textContent=tr(k);
  });
}

var SURAHS=[
{ord:1,n:96,ar:"العلق",en:"Al-Alaq",era:"meccan",year:"610 CE",v:19,desc:{en:"First revelation. The angel Jibreel commanded 'Read!' in the cave of Hira.",fr:"Premiere revelation. L'ange Jibril ordonna 'Lis!' dans la grotte de Hira.",ar:"أول ما نزل. أمر جبريل بـ'اقرأ' في غار حراء."}},
{ord:2,n:68,ar:"القلم",en:"Al-Qalam",era:"meccan",year:"610 CE",v:52,desc:{en:"The Pen — emphasizes morality and the Prophet's noble character.",fr:"Le Calame — met l'accent sur la moralite et le noble caractere du Prophete.",ar:"القلم — تؤكد على الأخلاق وشخصية النبي ﷺ النبيلة."}},
{ord:3,n:73,ar:"المزمل",en:"Al-Muzzammil",era:"meccan",year:"610 CE",v:20,desc:{en:"The Enwrapped One — instructions for night prayer and patience.",fr:"L'Enveloppe — instructions pour la priere nocturne.",ar:"المزمل — تعليمات لقيام الليل والصبر."}},
{ord:4,n:74,ar:"المدثر",en:"Al-Muddathir",era:"meccan",year:"610 CE",v:56,desc:{en:"The Cloaked One — command to rise and warn mankind.",fr:"Le Revetu — ordre de se lever et d'avertir l'humanite.",ar:"المدثر — الأمر بالقيام وإنذار البشرية."}},
{ord:5,n:1,ar:"الفاتحة",en:"Al-Fatiha",era:"meccan",year:"610 CE",v:7,desc:{en:"The Opening — the most recited surah, essence of the Quran.",fr:"L'Ouverture — la sourate la plus recitee, essence du Coran.",ar:"الفاتحة — أكثر سورة تلاوة، خلاصة القرآن."}},
{ord:6,n:111,ar:"المسد",en:"Al-Masad",era:"meccan",year:"611 CE",v:5,desc:{en:"The Palm Fibre — about Abu Lahab's opposition to Islam.",fr:"Les Fibres — sur l'opposition d'Abu Lahab a l'Islam.",ar:"المسد — عن معاداة أبي لهب للإسلام."}},
{ord:7,n:112,ar:"الإخلاص",en:"Al-Ikhlas",era:"meccan",year:"611 CE",v:4,desc:{en:"Sincerity — pure monotheism, equals one-third of the Quran.",fr:"Le Monotheisme pur — egal a un tiers du Coran.",ar:"الإخلاص — التوحيد الخالص، تعدل ثلث القرآن."}},
{ord:8,n:113,ar:"الفلق",en:"Al-Falaq",era:"meccan",year:"611 CE",v:5,desc:{en:"The Daybreak — seeking refuge from evil of creation.",fr:"L'Aube naissante — chercher refuge contre le mal.",ar:"الفلق — الاستعاذة من شر المخلوقات."}},
{ord:9,n:114,ar:"الناس",en:"An-Nas",era:"meccan",year:"611 CE",v:6,desc:{en:"Mankind — seeking refuge from the whisperer of evil.",fr:"Les Hommes — chercher refuge contre le tentateur.",ar:"الناس — الاستعاذة من الوسواس الخناس."}},
{ord:10,n:108,ar:"الكوثر",en:"Al-Kawthar",era:"meccan",year:"612 CE",v:3,desc:{en:"Abundance — shortest surah, divine gift to the Prophet.",fr:"L'Abondance — plus courte sourate, don divin au Prophete.",ar:"الكوثر — أقصر سورة، عطاء إلهي للنبي ﷺ."}},
{ord:11,n:53,ar:"النجم",en:"An-Najm",era:"meccan",year:"613 CE",v:62,desc:{en:"The Star — describes the Prophet's ascension (Mi'raj).",fr:"L'Etoile — decrit l'ascension du Prophete.",ar:"النجم — تصف معراج النبي ﷺ."}},
{ord:12,n:55,ar:"الرحمن",en:"Ar-Rahman",era:"medinan",year:"614 CE",v:78,desc:{en:"The Most Merciful — catalogues of Allah's blessings to creation.",fr:"Le Misericordieux — catalogue des bienfaits d'Allah.",ar:"الرحمن — تعداد نعم الله على الخلق."}},
{ord:13,n:36,ar:"يس",en:"Ya-Sin",era:"meccan",year:"615 CE",v:83,desc:{en:"Ya-Sin — the Heart of the Quran, themes of resurrection.",fr:"Ya-Sin — le Coeur du Coran, themes de resurrection.",ar:"يس — قلب القرآن، موضوعات البعث."}},
{ord:14,n:18,ar:"الكهف",en:"Al-Kahf",era:"meccan",year:"616 CE",v:110,desc:{en:"The Cave — four profound stories of faith and trial.",fr:"La Caverne — quatre recits profonds de foi et d'epreuve.",ar:"الكهف — أربع قصص عميقة عن الإيمان والابتلاء."}},
{ord:15,n:19,ar:"مريم",en:"Maryam",era:"meccan",year:"616 CE",v:98,desc:{en:"Mary — story of Maryam and the birth of Isa (Jesus).",fr:"Marie — l'histoire de Maryam et la naissance de Issa.",ar:"مريم — قصة مريم وولادة عيسى عليه السلام."}},
{ord:16,n:12,ar:"يوسف",en:"Yusuf",era:"meccan",year:"617 CE",v:111,desc:{en:"Joseph — the best of stories, patience through hardship.",fr:"Joseph — le plus beau recit, patience dans l'epreuve.",ar:"يوسف — أحسن القصص، الصبر في الشدائد."}},
{ord:17,n:17,ar:"الإسراء",en:"Al-Isra",era:"meccan",year:"619 CE",v:111,desc:{en:"The Night Journey — from Mecca to Jerusalem in one night.",fr:"Le Voyage nocturne — de La Mecque a Jerusalem en une nuit.",ar:"الإسراء — من مكة إلى القدس في ليلة واحدة."}},
{ord:18,n:2,ar:"البقرة",en:"Al-Baqarah",era:"medinan",year:"623 CE",v:286,desc:{en:"The Cow — longest surah, comprehensive legal and spiritual guidance.",fr:"La Vache — plus longue sourate, guide juridique et spirituel.",ar:"البقرة — أطول سورة، توجيهات شرعية وروحانية شاملة."}},
{ord:19,n:8,ar:"الأنفال",en:"Al-Anfal",era:"medinan",year:"624 CE",v:75,desc:{en:"The Spoils of War — revealed after the Battle of Badr.",fr:"Le Butin — revelee apres la bataille de Badr.",ar:"الأنفال — نزلت بعد غزوة بدر."}},
{ord:20,n:3,ar:"آل عمران",en:"Ali 'Imran",era:"medinan",year:"625 CE",v:200,desc:{en:"Family of Imran — after Uhud, perseverance and faith.",fr:"La Famille d'Imran — apres Uhud, perseverance et foi.",ar:"آل عمران — بعد أحد، المثابرة والإيمان."}},
{ord:21,n:33,ar:"الأحزاب",en:"Al-Ahzab",era:"medinan",year:"627 CE",v:73,desc:{en:"The Confederates — Battle of the Trench, social reforms.",fr:"Les Coalises — bataille du Fosse, reformes sociales.",ar:"الأحزاب — غزوة الخندق، إصلاحات اجتماعية."}},
{ord:22,n:48,ar:"الفتح",en:"Al-Fath",era:"medinan",year:"628 CE",v:29,desc:{en:"The Victory — Treaty of Hudaybiyyah declared a clear victory.",fr:"La Victoire eclatante — Traite de Hudaybiyyah.",ar:"الفتح — صلح الحديبية أُعلن فتحاً مبيناً."}},
{ord:23,n:49,ar:"الحجرات",en:"Al-Hujurat",era:"medinan",year:"629 CE",v:18,desc:{en:"The Chambers — manners, brotherhood, avoiding suspicion.",fr:"Les Appartements — manieres, fraternite, eviter les soupcons.",ar:"الحجرات — الآداب، الأخوة، اجتناب الظن."}},
{ord:24,n:62,ar:"الجمعة",en:"Al-Jumu'ah",era:"medinan",year:"630 CE",v:11,desc:{en:"Friday — importance of congregational Friday prayer.",fr:"Le Vendredi — importance de la priere du vendredi.",ar:"الجمعة — أهمية صلاة الجمعة."}},
{ord:25,n:110,ar:"النصر",en:"An-Nasr",era:"medinan",year:"630 CE",v:3,desc:{en:"The Divine Support — after the Conquest of Mecca.",fr:"Le Secours — apres la conquete de La Mecque.",ar:"النصر — بعد فتح مكة."}},
{ord:26,n:4,ar:"النساء",en:"An-Nisa",era:"medinan",year:"626 CE",v:176,desc:{en:"The Women — rights, inheritance, and social justice.",fr:"Les Femmes — droits, heritage et justice sociale.",ar:"النساء — الحقوق، الميراث، والعدالة الاجتماعية."}},
{ord:27,n:5,ar:"المائدة",en:"Al-Ma'idah",era:"medinan",year:"631 CE",v:120,desc:{en:"The Table Spread — last surah on legal matters.",fr:"La Table servie — derniere sourate sur les questions juridiques.",ar:"المائدة — آخر سورة في الأحكام."}},
{ord:28,n:9,ar:"التوبة",en:"At-Tawbah",era:"medinan",year:"631 CE",v:129,desc:{en:"Repentance — only surah without Bismillah opening.",fr:"Le Repentir — seule sourate sans Bismillah.",ar:"التوبة — السورة الوحيدة بدون بسملة."}}
];

var curLang="ar",soundOn=true,actx,readCount=0,filter="all",readSet={};
var HS_KEY="wdiy-hs-surah-timeline-scroll";
function openHelp(){document.getElementById("helpOverlay").classList.add("open");document.getElementById("helpPanel").classList.add("open");}
function closeHelp(){document.getElementById("helpOverlay").classList.remove("open");document.getElementById("helpPanel").classList.remove("open");}
function setLang(l){currentLang=l==="ar"?"ar":"en";curLang=l;document.documentElement.lang=l;document.documentElement.dir=l==="ar"?"rtl":"ltr";document.querySelectorAll("[data-lang]").forEach(function(b){b.classList.toggle("on",b.dataset.lang===l);});updateUI();buildTimeline();try{localStorage.setItem("wdiy-lang",l);}catch(e){}}
function setTheme(th){document.documentElement.dataset.theme=th;document.querySelectorAll("[data-thm]").forEach(function(b){b.classList.toggle("on",b.dataset.thm===th);});try{localStorage.setItem("wdiy-theme",th);}catch(e){}}
function snd(t){if(!soundOn)return;if(!actx)actx=new(window.AudioContext||window.webkitAudioContext)();var o=actx.createOscillator(),g=actx.createGain();o.connect(g);g.connect(actx.destination);g.gain.value=.03;var n=actx.currentTime;o.frequency.value=t==="open"?600:500;o.type="sine";g.gain.exponentialRampToValueAtTime(.001,n+.08);o.start(n);o.stop(n+.08);}

function buildTimeline(){
var tl=document.getElementById("timeline");tl.innerHTML="";
var lastYear="";
var items=SURAHS.filter(function(s){return filter==="all"||s.era===filter;});
items.forEach(function(s){
if(s.year!==lastYear){lastYear=s.year;var ym=document.createElement("div");ym.className="year-marker";ym.textContent=s.year;tl.appendChild(ym);}
var item=document.createElement("div");item.className="tl-item";
var dot=document.createElement("div");dot.className="tl-dot "+s.era;
var card=document.createElement("div");card.className="tl-card"+(readSet[s.n]?" expanded":"");
card.innerHTML='<div class="tl-num">#'+s.ord+' (Surah '+s.n+')</div><div class="tl-name">'+s.ar+'</div><div class="tl-en">'+s.en+' — '+s.v+' verses — '+s.era+'</div><div class="tl-meta">'+s.year+'</div><div class="tl-desc">'+(s.desc[curLang]||s.desc.en)+'</div>';
card.onclick=function(){
card.classList.toggle("expanded");
if(!readSet[s.n]){readSet[s.n]=true;readCount++;document.getElementById("readNum").textContent=readCount;document.getElementById("expPill").textContent="Read: "+readCount;}
snd("open");
try{var best=parseInt(localStorage.getItem(HS_KEY))||0;if(readCount>best)localStorage.setItem(HS_KEY,readCount);}catch(e){}
};
item.appendChild(dot);item.appendChild(card);tl.appendChild(item);
});
}

document.addEventListener("DOMContentLoaded",function(){
document.querySelectorAll(".era-btn").forEach(function(b){b.onclick=function(){filter=b.dataset.era;document.querySelectorAll(".era-btn").forEach(function(x){x.classList.remove("active");});b.classList.add("active");buildTimeline();snd("click");};});
document.querySelectorAll("[data-lang]").forEach(function(b){b.addEventListener("click",function(){setLang(b.dataset.lang);snd("click");});});
document.querySelectorAll("[data-thm]").forEach(function(b){b.addEventListener("click",function(){setTheme(b.dataset.thm);snd("click");});});
document.getElementById("enterBtn").onclick=function(){document.getElementById("splash").style.display="none";document.getElementById("app").classList.add("on");document.getElementById("backLink").style.display="block";buildTimeline();};
document.getElementById("soundBtn").onclick=function(){soundOn=!soundOn;this.textContent=soundOn?"Sound ON":"Sound OFF";};
document.addEventListener("keydown",function(e){if(e.key==="Escape")closeHelp();});
document.querySelectorAll(".help-tab").forEach(function(tab){tab.addEventListener("click",function(){document.querySelectorAll(".help-tab").forEach(function(t){t.classList.remove("active");});document.querySelectorAll(".help-content").forEach(function(c){c.classList.remove("active");});tab.classList.add("active");document.getElementById("help-"+tab.dataset.tab).classList.add("active");});});
setLang("ar");try{var sl=localStorage.getItem("wdiy-lang");if(sl)setLang(sl);var st=localStorage.getItem("wdiy-theme");if(st)setTheme(st);}catch(e){}
});
</script></body></html>